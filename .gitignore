# JetBrains IDE specific files (IntelliJ, WebStorm, PyCharm, etc.)
.idea/

# Node.js dependencies
node_modules/

# Optional: Add other common things you might want to ignore
# Build output directories
dist/
build/
out/

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables file (VERY important to ignore if it contains secrets)
.env
.env.*
!.env.example # Usually you commit an example env file

# OS generated files
.DS_Store
Thumbs.db